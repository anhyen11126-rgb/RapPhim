generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Movie {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  posterUrl   String
  trailerUrl  String?
  description String
  genre       String
  duration    Int        // Thời lượng tính theo phút
  ageRating   String     // P, T13, T16, T18
  releaseDate DateTime
  status      String     @default("NOW_SHOWING") // NOW_SHOWING, COMING_SOON
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  showtimes   Showtime[]
}

model Showtime {
  id        Int            @id @default(autoincrement())
  movieId   Int
  movie     Movie          @relation(fields: [movieId], references: [id], onDelete: Cascade)
  roomName  String         // VD: "Phòng 01 - IMAX", "Phòng 02 - 2D"
  startTime DateTime
  price     Float          // Giá vé cơ bản (VND)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  seats     ShowtimeSeat[]
  bookings  Booking[]
}

model ShowtimeSeat {
  id            Int       @id @default(autoincrement())
  showtimeId    Int
  showtime      Showtime  @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatNumber    String    // VD: "A1", "C4"
  row           String    // "A", "B", "C"...
  col           Int       // 1, 2, 3...
  type          String    @default("STANDARD") // STANDARD, VIP
  status        String    @default("AVAILABLE") // AVAILABLE, HOLDING, BOOKED
  holdExpiresAt DateTime?
  bookingId     Int?
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([showtimeId, seatNumber])
}

model Concession {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Booking {
  id            Int            @id @default(autoincrement())
  bookingCode   String         @unique // VD: #MTX892144
  showtimeId    Int
  showtime      Showtime       @relation(fields: [showtimeId], references: [id])
  customerName  String
  customerPhone String
  customerEmail String?
  seats         String         // Lưu tóm tắt chuỗi ghế, VD: "A1, A2"
  concessions   String?        // Lưu tóm tắt bắp nước, VD: "1x Bắp rang bơ, 2x Coca"
  totalAmount   Float
  status        String         @default("PAID") // PENDING, PAID, CANCELLED
  paymentMethod String         @default("MOMO") // MOMO, VNPAY, CASH
  createdAt     DateTime       @default(now())

  bookedSeats   ShowtimeSeat[]
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Mật khẩu đã hash bcrypt
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

