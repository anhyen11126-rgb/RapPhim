PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="movietix_jwt_secret_key_change_me"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/movietix_db?retryWrites=true&w=majority"
#Đã thêm 
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_16_digit_app_password"

